# Optional — defaults to /api proxy in dev (see vite.config.js)
VITE_API_URL=

# Must match backend SIWE_DOMAIN and SIWE_URI for production builds
VITE_SIWE_DOMAIN=localhost
VITE_SIWE_URI=http://localhost:5173

# Production example:
# VITE_API_URL=https://api-testnet.ballenaazul.ltd
# VITE_SIWE_DOMAIN=ballenaazul.ltd
# VITE_SIWE_URI=https://ballenaazul.ltd
